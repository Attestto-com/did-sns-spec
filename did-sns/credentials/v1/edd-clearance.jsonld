{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "id": "@id",
    "type": "@type",

    "AttesttoEDD": "https://spec.attestto.com/credentials/v1/edd-clearance#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "EddClearanceCredential": {
      "@id": "AttesttoEDD:EddClearanceCredential",
      "@context": {
        "@version": 1.1,
        "@protected": true,

        "id": "@id",
        "type": "@type",

        "tierLabel": {
          "@id": "AttesttoEDD:tierLabel",
          "@type": "xsd:string"
        },
        "clearedCumulativeThreshold": {
          "@id": "AttesttoEDD:clearedCumulativeThreshold",
          "@type": "xsd:decimal"
        },
        "clearedSingleTxThreshold": {
          "@id": "AttesttoEDD:clearedSingleTxThreshold",
          "@type": "xsd:decimal"
        },
        "currency": {
          "@id": "AttesttoEDD:currency",
          "@type": "xsd:string"
        },
        "evaluationPeriod": {
          "@id": "AttesttoEDD:evaluationPeriod",
          "@type": "xsd:string"
        },
        "documentsProvided": {
          "@id": "AttesttoEDD:documentsProvided",
          "@container": "@set"
        },
        "proofOfAddressVerified": {
          "@id": "AttesttoEDD:proofOfAddressVerified",
          "@type": "xsd:boolean"
        },
        "sourceOfFundsVerified": {
          "@id": "AttesttoEDD:sourceOfFundsVerified",
          "@type": "xsd:boolean"
        },
        "enhancedScreeningPassed": {
          "@id": "AttesttoEDD:enhancedScreeningPassed",
          "@type": "xsd:boolean"
        },
        "officerApproval": {
          "@id": "AttesttoEDD:officerApproval",
          "@context": {
            "approved": { "@id": "AttesttoEDD:officerApproved", "@type": "xsd:boolean" },
            "approverDid": { "@id": "AttesttoEDD:approverDid", "@type": "xsd:string" },
            "approvedAt": { "@id": "AttesttoEDD:approvedAt", "@type": "xsd:dateTime" }
          }
        },
        "riskAssessment": {
          "@id": "AttesttoEDD:riskAssessment",
          "@context": {
            "level": { "@id": "AttesttoEDD:riskLevel", "@type": "xsd:string" },
            "score": { "@id": "AttesttoEDD:riskScore", "@type": "xsd:integer" },
            "factors": { "@id": "AttesttoEDD:riskFactors", "@container": "@set" }
          }
        },
        "jurisdiction": {
          "@id": "AttesttoEDD:jurisdiction",
          "@type": "xsd:string"
        },
        "regulatoryFramework": {
          "@id": "AttesttoEDD:regulatoryFramework",
          "@type": "xsd:string"
        },
        "clearanceValidFrom": {
          "@id": "AttesttoEDD:clearanceValidFrom",
          "@type": "xsd:dateTime"
        },
        "clearanceValidUntil": {
          "@id": "AttesttoEDD:clearanceValidUntil",
          "@type": "xsd:dateTime"
        },
        "relatedCredentials": {
          "@id": "AttesttoEDD:relatedCredentials",
          "@container": "@set",
          "@context": {
            "credentialId": { "@id": "AttesttoEDD:relatedCredentialId", "@type": "xsd:string" },
            "credentialType": { "@id": "AttesttoEDD:relatedCredentialType", "@type": "xsd:string" }
          }
        }
      }
    },

    "EddClearanceSelectiveDisclosure": {
      "@id": "AttesttoEDD:EddClearanceSelectiveDisclosure",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "disclosedFields": {
          "@id": "AttesttoEDD:disclosedFields",
          "@container": "@set"
        },
        "meetsMinimumTier": {
          "@id": "AttesttoEDD:meetsMinimumTier",
          "@type": "xsd:boolean"
        },
        "requiredTier": {
          "@id": "AttesttoEDD:requiredTier",
          "@type": "xsd:string"
        },
        "isCurrent": {
          "@id": "AttesttoEDD:isCurrent",
          "@type": "xsd:boolean"
        }
      }
    }
  }
}

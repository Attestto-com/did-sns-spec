{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "id": "@id",
    "type": "@type",

    "AttesttoKYC": "https://spec.attestto.com/credentials/v1/identity-verification#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "IdentityVerificationCredential": {
      "@id": "AttesttoKYC:IdentityVerificationCredential",
      "@context": {
        "@version": 1.1,
        "@protected": true,

        "id": "@id",
        "type": "@type",

        "fullName": {
          "@id": "AttesttoKYC:fullName",
          "@type": "xsd:string"
        },
        "dateOfBirth": {
          "@id": "AttesttoKYC:dateOfBirth",
          "@type": "xsd:date"
        },
        "nationality": {
          "@id": "AttesttoKYC:nationality",
          "@type": "xsd:string"
        },
        "nationalId": {
          "@id": "AttesttoKYC:nationalId",
          "@type": "xsd:string"
        },
        "documentType": {
          "@id": "AttesttoKYC:documentType",
          "@type": "xsd:string"
        },
        "documentNumber": {
          "@id": "AttesttoKYC:documentNumber",
          "@type": "xsd:string"
        },
        "documentCountry": {
          "@id": "AttesttoKYC:documentCountry",
          "@type": "xsd:string"
        },
        "documentExpiry": {
          "@id": "AttesttoKYC:documentExpiry",
          "@type": "xsd:date"
        },
        "documentFrontHash": {
          "@id": "AttesttoKYC:documentFrontHash",
          "@type": "xsd:string"
        },
        "documentBackHash": {
          "@id": "AttesttoKYC:documentBackHash",
          "@type": "xsd:string"
        },
        "selfieHash": {
          "@id": "AttesttoKYC:selfieHash",
          "@type": "xsd:string"
        },
        "phoneNumber": {
          "@id": "AttesttoKYC:phoneNumber",
          "@type": "xsd:string"
        },
        "verificationLevel": {
          "@id": "AttesttoKYC:verificationLevel",
          "@type": "xsd:string"
        },
        "verificationMethod": {
          "@id": "AttesttoKYC:verificationMethod",
          "@type": "xsd:string"
        },
        "livenessCheckPassed": {
          "@id": "AttesttoKYC:livenessCheckPassed",
          "@type": "xsd:boolean"
        },
        "documentAuthenticity": {
          "@id": "AttesttoKYC:documentAuthenticity",
          "@type": "xsd:string"
        },
        "sanctionsScreeningPassed": {
          "@id": "AttesttoKYC:sanctionsScreeningPassed",
          "@type": "xsd:boolean"
        },
        "pepScreeningPassed": {
          "@id": "AttesttoKYC:pepScreeningPassed",
          "@type": "xsd:boolean"
        },
        "jurisdiction": {
          "@id": "AttesttoKYC:jurisdiction",
          "@type": "xsd:string"
        },
        "regulatoryFramework": {
          "@id": "AttesttoKYC:regulatoryFramework",
          "@type": "xsd:string"
        },
        "verifiedAt": {
          "@id": "AttesttoKYC:verifiedAt",
          "@type": "xsd:dateTime"
        }
      }
    },

    "IdentityVerificationSelectiveDisclosure": {
      "@id": "AttesttoKYC:IdentityVerificationSelectiveDisclosure",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "disclosedFields": {
          "@id": "AttesttoKYC:disclosedFields",
          "@container": "@set"
        },
        "meetsMinimumAge": {
          "@id": "AttesttoKYC:meetsMinimumAge",
          "@type": "xsd:boolean"
        },
        "minimumAgeRequired": {
          "@id": "AttesttoKYC:minimumAgeRequired",
          "@type": "xsd:integer"
        },
        "countryInAllowList": {
          "@id": "AttesttoKYC:countryInAllowList",
          "@type": "xsd:boolean"
        },
        "meetsMinimumLevel": {
          "@id": "AttesttoKYC:meetsMinimumLevel",
          "@type": "xsd:boolean"
        },
        "requiredLevel": {
          "@id": "AttesttoKYC:requiredLevel",
          "@type": "xsd:string"
        },
        "sanctionsCleared": {
          "@id": "AttesttoKYC:sanctionsCleared",
          "@type": "xsd:boolean"
        },
        "isDocumentValid": {
          "@id": "AttesttoKYC:isDocumentValid",
          "@type": "xsd:boolean"
        }
      }
    }
  }
}

{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "id": "@id",
    "type": "@type",

    "AttesttoPoA": "https://spec.attestto.com/credentials/v1/proof-of-address#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "ProofOfAddressCredential": {
      "@id": "AttesttoPoA:ProofOfAddressCredential",
      "@context": {
        "@version": 1.1,
        "@protected": true,

        "id": "@id",
        "type": "@type",

        "addressType": {
          "@id": "AttesttoPoA:addressType",
          "@type": "xsd:string"
        },
        "country": {
          "@id": "AttesttoPoA:country",
          "@type": "xsd:string"
        },
        "region": {
          "@id": "AttesttoPoA:region",
          "@type": "xsd:string"
        },
        "locality": {
          "@id": "AttesttoPoA:locality",
          "@type": "xsd:string"
        },
        "postalCode": {
          "@id": "AttesttoPoA:postalCode",
          "@type": "xsd:string"
        },
        "streetAddress": {
          "@id": "AttesttoPoA:streetAddress",
          "@type": "xsd:string"
        },
        "documentType": {
          "@id": "AttesttoPoA:documentType",
          "@type": "xsd:string"
        },
        "documentIssuer": {
          "@id": "AttesttoPoA:documentIssuer",
          "@type": "xsd:string"
        },
        "documentDate": {
          "@id": "AttesttoPoA:documentDate",
          "@type": "xsd:date"
        },
        "verificationMethod": {
          "@id": "AttesttoPoA:verificationMethod",
          "@type": "xsd:string"
        },
        "verifiedAt": {
          "@id": "AttesttoPoA:verifiedAt",
          "@type": "xsd:dateTime"
        },
        "residencySince": {
          "@id": "AttesttoPoA:residencySince",
          "@type": "xsd:date"
        },
        "jurisdiction": {
          "@id": "AttesttoPoA:jurisdiction",
          "@type": "xsd:string"
        }
      }
    },

    "ProofOfAddressSelectiveDisclosure": {
      "@id": "AttesttoPoA:ProofOfAddressSelectiveDisclosure",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "disclosedFields": {
          "@id": "AttesttoPoA:disclosedFields",
          "@container": "@set"
        },
        "countryMatch": {
          "@id": "AttesttoPoA:countryMatch",
          "@type": "xsd:boolean"
        },
        "regionMatch": {
          "@id": "AttesttoPoA:regionMatch",
          "@type": "xsd:boolean"
        },
        "isCurrentAddress": {
          "@id": "AttesttoPoA:isCurrentAddress",
          "@type": "xsd:boolean"
        }
      }
    }
  }
}

{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "id": "@id",
    "type": "@type",

    "AttesttoSoF": "https://spec.attestto.com/credentials/v1/source-of-funds#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "SourceOfFundsCredential": {
      "@id": "AttesttoSoF:SourceOfFundsCredential",
      "@context": {
        "@version": 1.1,
        "@protected": true,

        "id": "@id",
        "type": "@type",

        "totalVerifiedAmount": {
          "@id": "AttesttoSoF:totalVerifiedAmount",
          "@type": "xsd:decimal"
        },
        "currency": {
          "@id": "AttesttoSoF:currency",
          "@type": "xsd:string"
        },
        "verificationPeriodStart": {
          "@id": "AttesttoSoF:verificationPeriodStart",
          "@type": "xsd:date"
        },
        "verificationPeriodEnd": {
          "@id": "AttesttoSoF:verificationPeriodEnd",
          "@type": "xsd:date"
        },
        "sourceBreakdown": {
          "@id": "AttesttoSoF:sourceBreakdown",
          "@context": {
            "@version": 1.1,
            "employment": { "@id": "AttesttoSoF:sourceEmployment", "@type": "xsd:decimal" },
            "business": { "@id": "AttesttoSoF:sourceBusiness", "@type": "xsd:decimal" },
            "investment": { "@id": "AttesttoSoF:sourceInvestment", "@type": "xsd:decimal" },
            "rental": { "@id": "AttesttoSoF:sourceRental", "@type": "xsd:decimal" },
            "pension": { "@id": "AttesttoSoF:sourcePension", "@type": "xsd:decimal" },
            "government": { "@id": "AttesttoSoF:sourceGovernment", "@type": "xsd:decimal" },
            "inheritance": { "@id": "AttesttoSoF:sourceInheritance", "@type": "xsd:decimal" },
            "sale_of_assets": { "@id": "AttesttoSoF:sourceSaleOfAssets", "@type": "xsd:decimal" },
            "crypto": { "@id": "AttesttoSoF:sourceCrypto", "@type": "xsd:decimal" },
            "other": { "@id": "AttesttoSoF:sourceOther", "@type": "xsd:decimal" }
          }
        },
        "confidenceScore": {
          "@id": "AttesttoSoF:confidenceScore",
          "@type": "xsd:integer"
        },
        "riskLevel": {
          "@id": "AttesttoSoF:riskLevel",
          "@type": "xsd:string"
        },
        "verificationMethod": {
          "@id": "AttesttoSoF:verificationMethod",
          "@type": "xsd:string"
        },
        "bankingSources": {
          "@id": "AttesttoSoF:bankingSources",
          "@type": "xsd:integer"
        },
        "jurisdiction": {
          "@id": "AttesttoSoF:jurisdiction",
          "@type": "xsd:string"
        },
        "regulatoryFramework": {
          "@id": "AttesttoSoF:regulatoryFramework",
          "@type": "xsd:string"
        }
      }
    },

    "SourceOfFundsSelectiveDisclosure": {
      "@id": "AttesttoSoF:SourceOfFundsSelectiveDisclosure",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "disclosedFields": {
          "@id": "AttesttoSoF:disclosedFields",
          "@container": "@set"
        },
        "amountRange": {
          "@id": "AttesttoSoF:amountRange",
          "@context": {
            "min": { "@id": "AttesttoSoF:amountRangeMin", "@type": "xsd:decimal" },
            "max": { "@id": "AttesttoSoF:amountRangeMax", "@type": "xsd:decimal" }
          }
        },
        "meetsThreshold": {
          "@id": "AttesttoSoF:meetsThreshold",
          "@type": "xsd:boolean"
        },
        "thresholdAmount": {
          "@id": "AttesttoSoF:thresholdAmount",
          "@type": "xsd:decimal"
        }
      }
    }
  }
}
